# Settings for slurm.sh. Copy this file to `.env`, then edit the values:
#   cp example.env .env
# Your `.env` is personal -- it holds your own paths and is not shared with
# the rest of the lab (it stays out of version control).
#
# Tip: keep every path below on shared storage (your home folder or /stelmo).
# The compute machines cannot see files in local /tmp.

# --- Your environment -------------------------------------------------------
# Where conda lives, and which environment has spyglass installed.
#
# To find SPYGLASS_CONDA_PATH, run:
#     conda info --base
# and add "/etc/profile.d/conda.sh" to what it prints, e.g. if it prints
# /home/you/miniconda3 then the path is:
#     /home/you/miniconda3/etc/profile.d/conda.sh
# (Common bases: ~/miniconda3, ~/anaconda3, ~/miniforge3.)
#
# To find SPYGLASS_CONDA_ENV, run:
#     conda env list
# and use the name of the environment that has spyglass installed.
SPYGLASS_CONDA_PATH=/home/<you>/miniconda3/etc/profile.d/conda.sh
SPYGLASS_CONDA_ENV=spyglass

# --- Your database login ----------------------------------------------------
# Path to your DataJoint config file (the one with your username/password).
# Your username is used to label your jobs, so you can always find your work.
DJ_CONFIG=/home/<you>/path/to/dj_local_conf.json

# --- What to run ------------------------------------------------------------
# The populate script to run. Either a bare filename (resolved next to
# slurm.sh) or a full path to your own script anywhere on shared storage, e.g.
#   PY_SCRIPT=populate.py
#   PY_SCRIPT=/home/<you>/myproject/run_populate.py
PY_SCRIPT=populate.py

# --- How much to run at once ------------------------------------------------
# Rule of thumb: smaller requests start sooner. A worker that asks for fewer
# cores and less memory is easier for the scheduler to fit in, so it usually
# begins running faster. Ask for what your job needs, not the maximum.

# WORKERS: how many copies of the job run at the same time, sharing the work.
#   Just a count -- WORKERS=8 gives you 8 workers.
#   They coordinate automatically, so it is safe to ask for more than you need
#   -- extras simply find nothing left to do.
WORKERS=8

# MAX_CONCURRENT: cap how many workers run at once. Leave blank for no cap.
#   The rest wait their turn and start as earlier ones finish, so the whole job
#   still completes -- it just uses less of the cluster at any one moment. Set
#   this when you ask for a lot of workers and want to leave room for others.
#   e.g. WORKERS=20 with MAX_CONCURRENT=5 runs all 20, at most 5 at a time.
MAX_CONCURRENT=

# CORES: how many CPU cores each worker may use. A core is one processor lane;
#   more cores only help if the work itself runs in parallel. Most spyglass
#   populates use a single core, so the default of 4 is plenty -- raise it only
#   if a specific step is known to be multi-threaded.
CORES=4

# MEMORY: memory given to each worker (e.g. 16G). Leave blank for no limit.
#   The machines have ~1.5 TB total, so be generous but considerate of others.
MEMORY=16G

# MAX_HOURS: safety cap -- if a worker runs longer than this it is stopped.
#   Format is HH:MM:SS. Set it comfortably above your longest single item.
#   (Cluster hard limit is 4 days.)
MAX_HOURS=04:00:00

# --- Naming -----------------------------------------------------------------
# A short word added to your job name, e.g. <username>_populate_mytable, so you
# can tell your jobs apart at a glance.
JOB_TAG=populate_mytable

# --- Housekeeping -----------------------------------------------------------
# LOG_EXPIRATION_DAYS: tidy up your own old logs each time you submit.
#   Blank (the default) keeps every log forever. Otherwise give a whole number
#   of days; logs in your folder older than that are deleted at submit time:
#       LOG_EXPIRATION_DAYS=      ->  keep everything (default)
#       LOG_EXPIRATION_DAYS=30    ->  delete logs older than 30 days
#       LOG_EXPIRATION_DAYS=0     ->  delete all logs from previous runs
#   Only your own folder is touched, and only files ending in .log. Logs from
#   jobs that are still queued or running are always kept, so a long job never
#   loses the log it is writing.
LOG_EXPIRATION_DAYS=
